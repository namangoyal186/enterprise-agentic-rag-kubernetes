# ==============================================================================
# STREAMLIT UI - PRODUCTION DOCKERFILE (LIGHTWEIGHT)
# ==============================================================================
FROM python:3.11-slim

# Prevent Python from writing .pyc files & buffer stdout/stderr
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Install minimal system dependencies for health checks
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install lightweight UI dependencies
COPY requirements-ui.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements-ui.txt

# Copy Streamlit configuration and UI code
COPY .streamlit/ /app/.streamlit/
COPY ui/ /app/ui/
COPY app/ /app/app/

# Expose Streamlit port
EXPOSE 10000

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:${PORT:-10000}/_stcore/health || exit 1

# Start Streamlit in headless server mode
CMD ["sh", "-c", "streamlit run ui/app.py --server.port ${PORT:-10000} --server.address 0.0.0.0 --server.headless true"]
